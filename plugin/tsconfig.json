{
	"compilerOptions": {
		"target": "ES2022",
		"module": "Node16",
		"moduleResolution": "Node16",
		"lib": ["ES2023"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"rootDir": "src",
		"outDir": "build",
		"declaration": true,
		"types": ["node"]
	},
	"include": ["src"]
}
